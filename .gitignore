/ribice

# Build output for local development. dist/ is deliberately NOT ignored: it is
# committed so the site can be deployed, and the widget embedded, without a Go
# toolchain. Rebuild it with ./build.sh publish.
web/ribice.wasm
web/wasm_exec.js
web/demo-kb.json
.gif-venv/

# Knowledge-base build (see tools/README.md). The FCI standards are FCI's
# documents, not ours to redistribute: neither the cached PDFs nor the files
# holding their extracted text belong in the repository. Facts read out of
# them do -- those are in data/dogs.json. All of this regenerates.
tools/pdf/
tools/*.html
tools/*.csv
tools/fci-index.json
tools/fci-sections.json
tools/fci-extract.json
tools/fci-varieties.json
tools/spine.json
tools/coded.json
tools/credits.json
tools/pageviews.json
tools/cloud-images.json
tools/cloud-credits.json
tools/__pycache__/
